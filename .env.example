# ---------------------------------------------------------------------------
# Celestia Inn booking engine. Set these in Vercel: Project -> Settings ->
# Environment Variables. Never commit the filled-in values.
# ---------------------------------------------------------------------------

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠️ service_role key — full database access. Server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay: Dashboard -> Account & Settings -> API Keys
# Use rzp_test_* keys until you have tested end to end, then swap to rzp_live_*.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks: the secret you set when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# How long a guest's dates are held while they pay (minutes)
BOOKING_HOLD_MINUTES=15

# Owner booking alerts — the key the inquiry forms already use
WEB3FORMS_ACCESS_KEY=e1e750b2-ae69-4dd8-a683-1c88ea7e1538

# Optional: guest confirmation emails. Leave blank to skip them.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@yourdomain.com
